# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins ("*" allows all — dev only)
CORS_ORIGINS=*
# Public URL of this API (used in signed file links and call links)
PUBLIC_BASE_URL=http://localhost:3000
# Public URL of the web dashboard (linked from emails to admins)
DASHBOARD_URL=http://localhost:3001

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://neowell:neowell@localhost:5432/neowell?schema=public

# ── Auth ──────────────────────────────────────────────────
# Use long random strings in every non-local environment (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
OTP_SECRET=change-me-otp-secret-at-least-32-chars
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# SMS: "console" logs codes to stdout (development only), "twilio" sends real SMS
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set one of: a sender number (E.164) or a Messaging Service SID
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Email: "console" logs messages, "smtp" sends through any SMTP server
EMAIL_PROVIDER=console
EMAIL_FROM="NeoWell <no-reply@neowell.local>"
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Push: "fcm" = Firebase Cloud Messaging (raw device tokens), "expo" = Expo Push API, "log" = log only
PUSH_DRIVER=log
# fcm: service-account JSON (or the same JSON base64-encoded) from Firebase console
FIREBASE_SERVICE_ACCOUNT=
# Optional Expo push security token
EXPO_ACCESS_TOKEN=

# ── Storage (clinician documents, photos) ─────────────────
# "local" = disk, "r2" = Cloudflare R2 (private bucket; files are served via signed API links)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: another S3-compatible endpoint (defaults to the account's R2 endpoint) and region.
R2_ENDPOINT=
R2_REGION=auto
MAX_UPLOAD_MB=10
# Signs short-lived /files/... links
FILE_URL_SECRET=change-me-file-url-secret-at-least-32-chars

# ── Business ──────────────────────────────────────────────
# Platform commission on paid teleconsultations, in percent
PLATFORM_COMMISSION_PERCENT=15
# Shown alongside every RED result. Confirm the correct local numbers before launch.
EMERGENCY_PHONE_NUMBERS=

# ── Payments (MTN MoMo / Orange Money through an aggregator) ──
# SANDBOX confirms payments automatically (phone numbers ending in 000 fail)
# CAMPAY = real MTN MoMo / Orange Money collections (status is polled; no webhook needed)
PAYMENT_PROVIDER=SANDBOX
# demo: https://demo.campay.net/api   live: https://www.campay.net/api
CAMPAY_BASE_URL=https://demo.campay.net/api
# Either the permanent access token, or the username + password below
CAMPAY_PERMANENT_TOKEN=
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
PAYMENTS_WEBHOOK_SECRET=change-me-payments-webhook-secret-32chars

# ── Audio/video calls (LiveKit). Calls are disabled when unset. ──
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Self-hosted speech-to-text (OpenAI-compatible, e.g. Speaches/faster-whisper) ──
# Voice notes are stored but not transcribed when unset.
STT_URL=
STT_MODEL=Systran/faster-whisper-small

# ── Background jobs ──
JOBS_ENABLED=true
JOBS_POLL_MS=2000

# ── Logging ──
# Console plus two identical files (app.log, app.copy.log) in this folder.
LOG_DIR=logs

# ── Support contact, shown to suspended or unverified clinicians ──
SUPPORT_EMAIL=
SUPPORT_PHONE=
