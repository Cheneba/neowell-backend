# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins ("*" allows all — dev only)
CORS_ORIGINS=*
# Public URL of this API (used in signed file links and call links)
PUBLIC_BASE_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://neowell:neowell@localhost:5432/neowell?schema=public

# ── Auth ──────────────────────────────────────────────────
# Use long random strings in every non-local environment (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
OTP_SECRET=change-me-otp-secret-at-least-32-chars
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# SMS provider for OTPs: "console" logs codes to stdout (development only), "twilio" delivers via Twilio
SMS_PROVIDER=console
# Twilio — required when SMS_PROVIDER=twilio. Set TWILIO_FROM, or a Messaging Service SID instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Push notifications: "expo" sends via the Expo Push API, "fcm" via Firebase Cloud Messaging (HTTP v1), "log" only logs (tests)
PUSH_DRIVER=expo
# Optional Expo push security token
EXPO_ACCESS_TOKEN=
# Firebase service-account JSON, raw or base64-encoded — required when PUSH_DRIVER=fcm
FIREBASE_SERVICE_ACCOUNT=

# ── Storage (clinician documents, photos) ─────────────────
# "local" writes to STORAGE_LOCAL_DIR (dev/tests only — ephemeral on PaaS).
# "r2" stores objects in Cloudflare R2 (or any S3-compatible service) — use in production.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_MB=10
# Signs short-lived /files/... links
FILE_URL_SECRET=change-me-file-url-secret-at-least-32-chars

# Cloudflare R2 — required when STORAGE_DRIVER=r2.
# R2_ENDPOINT is optional and defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto

# ── Business ──────────────────────────────────────────────
# Platform commission on paid teleconsultations, in percent
PLATFORM_COMMISSION_PERCENT=15
# Shown alongside every RED result. Confirm the correct local numbers before launch.
EMERGENCY_PHONE_NUMBERS=

# ── Payments (MTN MoMo / Orange Money through an aggregator) ──
# SANDBOX confirms payments automatically (phone numbers ending in 000 fail)
# CAMPAY collects and refunds through CamPay (MTN MoMo + Orange Money)
PAYMENT_PROVIDER=SANDBOX
PAYMENTS_WEBHOOK_SECRET=change-me-payments-webhook-secret-32chars

# CamPay — required when PAYMENT_PROVIDER=CAMPAY (e.g. https://www.campay.net/api).
# CAMPAY_PERMANENT_TOKEN is optional: when set it is used directly instead of the username/password login.
CAMPAY_BASE_URL=
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_PERMANENT_TOKEN=

# ── Audio/video calls (LiveKit). Calls are disabled when unset. ──
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Self-hosted speech-to-text (OpenAI-compatible, e.g. Speaches/faster-whisper) ──
# Voice notes are stored but not transcribed when unset.
STT_URL=
STT_MODEL=Systran/faster-whisper-small

# ── Background jobs ──
JOBS_ENABLED=true
JOBS_POLL_MS=2000
