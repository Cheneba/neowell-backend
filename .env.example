# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed CORS origins ("*" allows all — dev only)
CORS_ORIGINS=*
# Public URL of this API (used in signed file links and call links)
PUBLIC_BASE_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://neowell:neowell@localhost:5432/neowell?schema=public

# ── Auth ──────────────────────────────────────────────────
# Use long random strings in every non-local environment (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
OTP_SECRET=change-me-otp-secret-at-least-32-chars
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# SMS provider for OTPs: "console" logs codes to stdout (development only)
SMS_PROVIDER=console
# Push notifications: "expo" sends via the Expo Push API, "log" only logs (tests)
PUSH_DRIVER=expo
# Optional Expo push security token
EXPO_ACCESS_TOKEN=

# ── Storage (clinician documents, photos) ─────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
MAX_UPLOAD_MB=10
# Signs short-lived /files/... links
FILE_URL_SECRET=change-me-file-url-secret-at-least-32-chars

# ── Business ──────────────────────────────────────────────
# Platform commission on paid teleconsultations, in percent
PLATFORM_COMMISSION_PERCENT=15
# Shown alongside every RED result. Confirm the correct local numbers before launch.
EMERGENCY_PHONE_NUMBERS=

# ── Payments (MTN MoMo / Orange Money through an aggregator) ──
# SANDBOX confirms payments automatically (phone numbers ending in 000 fail)
PAYMENT_PROVIDER=SANDBOX
PAYMENTS_WEBHOOK_SECRET=change-me-payments-webhook-secret-32chars

# ── Audio/video calls (LiveKit). Calls are disabled when unset. ──
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Self-hosted speech-to-text (OpenAI-compatible, e.g. Speaches/faster-whisper) ──
# Voice notes are stored but not transcribed when unset.
STT_URL=
STT_MODEL=Systran/faster-whisper-small

# ── Background jobs ──
JOBS_ENABLED=true
JOBS_POLL_MS=2000
